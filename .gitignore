# Credentials. NEVER commit these — an API key is often a billing credential.
.env.local
.env
*.pem
*.key

# Quarantined responses are triage material — they live in CI artifacts for
# 90 days, never in git. Bad bytes must not enter the archive.
quarantine/

__pycache__/
*.pyc
.venv/

# THE PUBLISHABLE/PRIVATE SEAM. Redistribution rights for Apify's store records
# are NOT established (see LICENSE-DATA), so no file containing their records is
# tracked. raw/ holds full records; derived/observations holds per-actor rows with
# username, name and usage. Both stay out of git. What IS tracked is public/,
# which is aggregate-only: bands, Lorenz points, per-partition totals and
# field-level volatility, with no actor identity in it -- 5.6 KB against 51 MB.
raw/
derived/observations/
